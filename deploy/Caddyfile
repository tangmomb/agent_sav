# À importer dans le Caddyfile du serveur, après avoir remplacé le domaine.
agent-sav.example.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 64KB
	}
	# Caddy ajoute l'adresse du visiteur à X-Forwarded-For : les limites en dépendent.
	reverse_proxy 127.0.0.1:8000
}
