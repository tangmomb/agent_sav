flowchart TD
    START([START]) --> action["Que souhaitez-vous faire ?<br/>échange / retour"]
    action --> article["Quel article ?<br/>liste issue du contexte"]
    article -->|échange| variante["Quelle taille / coloris ?"]
    variante --> stock[check_stock]
    stock -->|rupture| proposition["Rupture : proposer un retour"]
    stock -->|dispo| enregistrer["enregistrer_demande<br/>en attente validation boutique"]
    article -->|retour| enregistrer
    enregistrer --> notifier["notifier_boutique<br/>+ message client : demande transmise"]
    notifier --> boutique["⏸ INTERRUPT 1<br/>validation boutique : interface boutique"]
    boutique -->|refusée| refus["Mail client : refus + motif"]
    boutique -->|validée| mail["envoyer_mail_confirmation<br/>lien signé"]
    mail --> client["⏸ INTERRUPT 2<br/>confirmation client par mail"]
    client -->|refuse| annulation["Demande annulée"]
    client -->|confirme| recap["mail récapitulatif"]
    proposition & refus & annulation & recap --> FIN([END])
